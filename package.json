{
    "name": "eslint-config-jwalker",
    "version": "12.3.0",
    "description": "Shareable framework-agnostic ESLint config",
    "author": "Jonatas Walker",
    "homepage": "https://github.com/jonataswalker/eslint-config-jwalker",
    "type": "module",
    "engines": {
        "node": "^22.20 || ^24"
    },
    "exports": {
        "./package.json": "./package.json",
        ".": "./config/index.js"
    },
    "types": "./config/index.d.ts",
    "files": [
        "config"
    ],
    "keywords": [
        "eslint-config"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/jonataswalker/eslint-config-jwalker.git"
    },
    "bugs": {
        "url": "https://github.com/jonataswalker/eslint-config-jwalker/issues"
    },
    "license": "MIT",
    "scripts": {
        "prelint": "npm run knip",
        "lint": "eslint .",
        "lint:fix": "npm run lint -- --fix",
        "config": "eslint --print-config index.js",
        "view:config": "npx @eslint/config-inspector",
        "gen:types": "tsc",
        "knip": "knip",
        "test": "node --test **/*.spec.js",
        "release": "release-it --no-npm.publish"
    },
    "dependencies": {
        "@eslint-community/eslint-plugin-eslint-comments": "4.7.2",
        "@eslint/js": "10.0.1",
        "@stylistic/eslint-plugin": "5.10.0",
        "@typescript-eslint/eslint-plugin": "8.66.0",
        "@typescript-eslint/parser": "8.66.0",
        "@typescript-eslint/utils": "8.66.0",
        "eslint": "10.8.0",
        "eslint-config-flat-gitignore": "2.3.0",
        "eslint-import-resolver-typescript": "4.4.5",
        "eslint-plugin-array-func": "5.1.1",
        "eslint-plugin-es-x": "10.0.0",
        "eslint-plugin-format": "2.0.1",
        "eslint-plugin-import-x": "4.17.1",
        "eslint-plugin-jsonc": "3.4.1",
        "eslint-plugin-n": "18.2.2",
        "eslint-plugin-perfectionist": "5.10.1",
        "eslint-plugin-promise": "7.3.0",
        "eslint-plugin-security": "4.0.1",
        "eslint-plugin-sonarjs": "4.2.0",
        "eslint-plugin-unicorn": "73.0.0",
        "eslint-plugin-unused-imports": "4.4.1",
        "globals": "17.9.0",
        "jsonc-eslint-parser": "3.1.0",
        "typescript-eslint": "8.66.0"
    },
    "devDependencies": {
        "@eslint/config-inspector": "3.2.0",
        "@types/node": "26.1.2",
        "knip": "6.31.0",
        "release-it": "21.0.1",
        "typescript": "6.0.3"
    },
    "release-it": {
        "github": {
            "release": true
        }
    }
}
